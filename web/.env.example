# Instalazio klasikoa: kopiatu web/.env bezala eta bete.
# Docker: kopiatu errepoaren erroan .env.docker bezala eta erabili behean
# iruzkinetan dauden balioak (DB_HOST=db, DEBUG=False, ALLOWED_HOSTS eta MYSQL_*).

SECRET_KEY=
DEBUG=True
# Komaz bereizita. Lokalean hutsik utz daiteke (DEBUG=True). Docker: localhost,127.0.0.1
ALLOWED_HOSTS=
# Lokalean localhost; Docker-en db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Docker bakarrik (db edukiontziak datu-basea eta erabiltzailea sortzeko):
# MYSQL_DATABASE eta DB_NAME, MYSQL_USER eta DB_USER, MYSQL_PASSWORD eta DB_PASSWORD berdinak.
# MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
